# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. NEVER commit .env.
# On Vercel, set these under Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Supabase memory / user context
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── OpenRouter (https://openrouter.ai/keys) ─────────────────────────────────
# Required. There is deliberately no fallback in source.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model slugs MUST include the vendor prefix (e.g. "deepseek/deepseek-chat").
# A bare slug like "qwen3-coder" is rejected by OpenRouter.
CHAT_MODEL=deepseek/deepseek-chat
SUMMARY_MODEL=deepseek/deepseek-chat

CHAT_TEMPERATURE=0.7
SUMMARY_TEMPERATURE=0.3
CHAT_MAX_TOKENS=110
SUMMARY_MAX_TOKENS=100

# ── Session limits ──────────────────────────────────────────────────────────
# Messages allowed per session before the reflection gate appears.
MAX_MESSAGES_PER_SESSION=15

# Optional: a secret phrase that lifts the session limit when typed in chat.
# Leave empty to disable the override entirely.
OVERRIDE_CODE=
